                    </div>

                </div>

            </div>


            <div class="timeline-item">

                <div class="timeline-dot"></div>
                <div class="timeline-line"></div>

                <div class="timeline-content">

                    <strong>
                        Manufacturing Completed
                    </strong>

                    <div class="timeline-date">
