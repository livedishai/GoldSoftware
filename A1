<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Jewellery ERP — Inventory & Stock Control</title>

<style>
*{
    margin:0;
    padding:0;
    box-sizing:border-box;
}

:root{
    --bg:#f5f5f3;
    --sidebar:#171716;
    --sidebar2:#20201e;
    --card:#ffffff;
    --text:#1d1d1b;
    --muted:#777773;
    --border:#e7e7e3;
    --gold:#b58a45;
    --gold-light:#f4ead8;
    --green:#2d7d5a;
    --green-bg:#e8f5ee;
    --orange:#b36b18;
    --orange-bg:#fff1dc;
    --red:#b54747;
    --red-bg:#fdeaea;
    --blue:#4a6fa5;
    --blue-bg:#eaf0f8;
    --shadow:0 8px 30px rgba(0,0,0,.05);
}

body{
    font-family:Inter, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    background:var(--bg);
    color:var(--text);
}

/* =========================
   LAYOUT
========================= */

.app{
    display:flex;
    min-height:100vh;
}

.sidebar{
    width:255px;
    background:var(--sidebar);
    color:white;
    padding:24px 16px;
    position:fixed;
    left:0;
    top:0;
    bottom:0;
    z-index:50;
}

.logo{
    display:flex;
    align-items:center;
    gap:12px;
    padding:0 10px 28px;
    border-bottom:1px solid rgba(255,255,255,.08);
}

.logo-mark{
    width:38px;
    height:38px;
    border:1px solid var(--gold);
    border-radius:10px;
    display:flex;
    align-items:center;
    justify-content:center;
    color:var(--gold);
    font-size:18px;
}

.logo h2{
    font-size:15px;
    letter-spacing:.5px;
}

.logo span{
    display:block;
    color:#858581;
    font-size:10px;
    margin-top:2px;
}

.nav{
    margin-top:25px;
}

.nav-title{
    color:#666661;
    font-size:10px;
    text-transform:uppercase;
    letter-spacing:1.2px;
    padding:0 12px 10px;
}

.nav-item{
    display:flex;
    align-items:center;
    gap:12px;
    padding:12px;
    margin-bottom:4px;
    border-radius:9px;
    color:#aaa9a5;
    cursor:pointer;
    font-size:13px;
    transition:.2s;
}

.nav-item:hover{
    background:var(--sidebar2);
    color:white;
}

.nav-item.active{
    background:#292925;
    color:white;
}

.nav-icon{
    width:20px;
    text-align:center;
    opacity:.85;
}

.nav-arrow{
    margin-left:auto;
    font-size:10px;
}

.sidebar-bottom{
    position:absolute;
    left:16px;
    right:16px;
    bottom:20px;
    border-top:1px solid rgba(255,255,255,.08);
    padding-top:15px;
}

.user{
    display:flex;
    align-items:center;
    gap:10px;
}

.avatar{
    width:34px;
    height:34px;
    border-radius:50%;
    background:#343430;
    display:flex;
    align-items:center;
    justify-content:center;
    color:#d6b273;
    font-size:12px;
}

.user-name{
    font-size:12px;
}

.user-role{
    color:#777;
    font-size:10px;
    margin-top:2px;
}

.main{
    margin-left:255px;
    width:calc(100% - 255px);
}

/* =========================
   HEADER
========================= */

.topbar{
    height:70px;
    background:white;
    border-bottom:1px solid var(--border);
    display:flex;
    align-items:center;
    justify-content:space-between;
    padding:0 32px;
    position:sticky;
    top:0;
    z-index:30;
}

.branch{
    display:flex;
    align-items:center;
    gap:8px;
    font-size:13px;
}

.branch-label{
    color:var(--muted);
}

.top-actions{
    display:flex;
    align-items:center;
    gap:18px;
}

.icon-btn{
    border:0;
    background:transparent;
    cursor:pointer;
    font-size:17px;
    position:relative;
}

.notification-dot{
    position:absolute;
    width:6px;
    height:6px;
    background:#b54747;
    border-radius:50%;
    top:0;
    right:0;
}

/* =========================
   CONTENT
========================= */

.content{
    padding:30px 32px 50px;
}

.page-header{
    display:flex;
    align-items:flex-start;
    justify-content:space-between;
    margin-bottom:25px;
}

.eyebrow{
    color:var(--gold);
    font-size:11px;
    text-transform:uppercase;
    letter-spacing:1.4px;
    font-weight:600;
    margin-bottom:7px;
}

.page-title{
    font-size:28px;
    letter-spacing:-.7px;
}

.page-description{
    color:var(--muted);
    font-size:13px;
    margin-top:7px;
}

.date{
    color:var(--muted);
    font-size:12px;
    margin-top:8px;
}

/* =========================
   BUTTONS
========================= */

.btn{
    border:0;
    border-radius:8px;
    padding:11px 16px;
    font-size:12px;
    cursor:pointer;
    transition:.2s;
    font-weight:600;
}

.btn-primary{
    background:var(--text);
    color:white;
}

.btn-primary:hover{
    background:#000;
}

.btn-gold{
    background:var(--gold);
    color:white;
}

.btn-outline{
    background:white;
    border:1px solid var(--border);
    color:var(--text);
}

/* =========================
   KPI
========================= */

.kpis{
    display:grid;
    grid-template-columns:repeat(4,1fr);
    gap:16px;
    margin-bottom:20px;
}

.kpi{
    background:white;
    border:1px solid var(--border);
    border-radius:12px;
    padding:20px;
    box-shadow:var(--shadow);
}

.kpi-top{
    display:flex;
    align-items:center;
    justify-content:space-between;
}

.kpi-label{
    font-size:11px;
    color:var(--muted);
    text-transform:uppercase;
    letter-spacing:.6px;
}

.kpi-icon{
    width:32px;
    height:32px;
    border-radius:8px;
    display:flex;
    align-items:center;
    justify-content:center;
    background:var(--gold-light);
    color:var(--gold);
}

.kpi-value{
    font-size:24px;
    font-weight:700;
    margin-top:12px;
}

.kpi-meta{
    margin-top:7px;
    font-size:10px;
    color:var(--muted);
}

.up{
    color:var(--green);
}

/* =========================
   GRID
========================= */

.grid-2{
    display:grid;
    grid-template-columns:1.35fr 1fr;
    gap:18px;
    margin-bottom:20px;
}

.card{
    background:white;
    border:1px solid var(--border);
    border-radius:12px;
    box-shadow:var(--shadow);
}

.card-header{
    padding:18px 20px;
    border-bottom:1px solid var(--border);
    display:flex;
    align-items:center;
    justify-content:space-between;
}

.card-title{
    font-size:14px;
    font-weight:700;
}

.card-subtitle{
    color:var(--muted);
    font-size:10px;
    margin-top:3px;
}

.card-body{
    padding:20px;
}

/* =========================
   STOCK OVERVIEW
========================= */

.stock-row{
    margin-bottom:17px;
}

.stock-row:last-child{
    margin-bottom:0;
}

.stock-info{
    display:flex;
    justify-content:space-between;
    font-size:11px;
    margin-bottom:7px;
}

.stock-info span:last-child{
    color:var(--muted);
}

.progress{
    height:7px;
    background:#efefec;
    border-radius:10px;
    overflow:hidden;
}

.progress-fill{
    height:100%;
    border-radius:10px;
    background:var(--gold);
}

/* =========================
   LOCATION
========================= */

.location-row{
    display:flex;
    align-items:center;
    justify-content:space-between;
    padding:12px 0;
    border-bottom:1px solid #f0f0ed;
}

.location-row:last-child{
    border-bottom:0;
}

.location-left{
    display:flex;
    align-items:center;
    gap:10px;
}

.location-icon{
    width:34px;
    height:34px;
    background:#f4f4f1;
    border-radius:8px;
    display:flex;
    align-items:center;
    justify-content:center;
}

.location-name{
    font-size:12px;
    font-weight:600;
}

.location-detail{
    font-size:10px;
    color:var(--muted);
    margin-top:2px;
}

.location-value{
    font-size:12px;
    font-weight:700;
}

/* =========================
   ALERTS
========================= */

.alert{
    display:flex;
    align-items:center;
    gap:12px;
    padding:13px 0;
    border-bottom:1px solid #f0f0ed;
}

.alert:last-child{
    border-bottom:0;
}

.alert-icon{
    width:32px;
    height:32px;
    border-radius:8px;
    display:flex;
    align-items:center;
    justify-content:center;
}

.alert-red{
    background:var(--red-bg);
    color:var(--red);
}

.alert-orange{
    background:var(--orange-bg);
    color:var(--orange);
}

.alert-blue{
    background:var(--blue-bg);
    color:var(--blue);
}

.alert-content{
    flex:1;
}

.alert-title{
    font-size:11px;
    font-weight:700;
}

.alert-text{
    font-size:10px;
    color:var(--muted);
    margin-top:3px;
}

.alert-count{
    font-size:12px;
    font-weight:700;
}

/* =========================
   ACTIVITY
========================= */

.activity{
    display:flex;
    gap:13px;
    padding:13px 0;
    border-bottom:1px solid #f0f0ed;
}

.activity:last-child{
    border-bottom:0;
}

.activity-dot{
    width:8px;
    height:8px;
    border-radius:50%;
    background:var(--gold);
    margin-top:5px;
}

.activity-text{
    font-size:11px;
}

.activity-time{
    color:var(--muted);
    font-size:9px;
    margin-top:4px;
}

/* =========================
   TABLE
========================= */

.table-card{
    margin-top:20px;
}

.table-toolbar{
    padding:16px 20px;
    border-bottom:1px solid var(--border);
    display:flex;
    gap:10px;
    align-items:center;
    justify-content:space-between;
}

.search{
    position:relative;
    width:330px;
}

.search input{
    width:100%;
    height:38px;
    border:1px solid var(--border);
    border-radius:8px;
    padding:0 13px 0 36px;
    outline:none;
    font-size:11px;
}

.search input:focus{
    border-color:#c7a66b;
}

.search-icon{
    position:absolute;
    left:12px;
    top:11px;
    color:#999;
    font-size:13px;
}

.filters{
    display:flex;
    gap:8px;
}

select{
    height:38px;
    border:1px solid var(--border);
    border-radius:8px;
    background:white;
    padding:0 12px;
    font-size:11px;
    color:var(--text);
    outline:none;
}

.table-wrap{
    overflow-x:auto;
}

table{
    width:100%;
    border-collapse:collapse;
}

th{
    text-align:left;
    font-size:9px;
    text-transform:uppercase;
    letter-spacing:.7px;
    color:#888;
    background:#fafaf8;
    padding:12px 16px;
    border-bottom:1px solid var(--border);
}

td{
    padding:14px 16px;
    font-size:11px;
    border-bottom:1px solid #f1f1ee;
}

.item-cell{
    display:flex;
    align-items:center;
    gap:10px;
}

.item-image{
    width:40px;
    height:40px;
    border-radius:8px;
    object-fit:cover;
    background:#eee;
}

.item-name{
    font-weight:700;
}

.item-code{
    color:var(--muted);
    font-size:9px;
    margin-top:3px;
}

.weight{
    font-weight:600;
}

.status{
    display:inline-flex;
    align-items:center;
    gap:5px;
    padding:5px 8px;
    border-radius:20px;
    font-size:9px;
    font-weight:600;
}

.status-dot{
    width:5px;
    height:5px;
    border-radius:50%;
}

.available{
    background:var(--green-bg);
    color:var(--green);
}

.available .status-dot{
    background:var(--green);
}

.reserved{
    background:var(--orange-bg);
    color:var(--orange);
}

.reserved .status-dot{
    background:var(--orange);
}

.workshop{
    background:var(--blue-bg);
    color:var(--blue);
}

.workshop .status-dot{
    background:var(--blue);
}

.transit{
    background:#f0edf8;
    color:#6c58a8;
}

.transit .status-dot{
    background:#6c58a8;
}

.action{
    border:0;
    background:#f6f6f3;
    width:30px;
    height:30px;
    border-radius:7px;
    cursor:pointer;
}

/* =========================
   MODAL
========================= */

.modal-overlay{
    position:fixed;
    inset:0;
    background:rgba(0,0,0,.5);
    display:none;
    align-items:center;
    justify-content:center;
    z-index:100;
    padding:20px;
}

.modal-overlay.show{
    display:flex;
}

.modal{
    width:760px;
    max-width:100%;
    max-height:90vh;
    overflow:auto;
    background:white;
    border-radius:14px;
    box-shadow:0 30px 100px rgba(0,0,0,.25);
}

.modal-header{
    padding:20px 24px;
    border-bottom:1px solid var(--border);
    display:flex;
    justify-content:space-between;
    align-items:center;
}

.modal-title{
    font-size:17px;
    font-weight:700;
}

.close{
    border:0;
    background:#f4f4f1;
    width:32px;
    height:32px;
    border-radius:7px;
    cursor:pointer;
}

.modal-body{
    padding:24px;
}

/* =========================
   ITEM DETAIL
========================= */

.item-detail-grid{
    display:grid;
    grid-template-columns:220px 1fr;
    gap:24px;
}

.product-preview{
    height:220px;
    border-radius:12px;
    overflow:hidden;
    background:#eee;
}

.product-preview img{
    width:100%;
    height:100%;
    object-fit:cover;
}

.detail-title{
    font-size:21px;
    font-weight:700;
}

.detail-code{
    color:var(--muted);
    font-size:11px;
    margin-top:4px;
}

.detail-status{
    margin-top:12px;
}

.spec-grid{
    display:grid;
    grid-template-columns:repeat(3,1fr);
    gap:12px;
    margin-top:20px;
}

.spec{
    background:#fafaf8;
    padding:12px;
    border-radius:8px;
}

.spec-label{
    color:var(--muted);
    font-size:9px;
}

.spec-value{
    font-size:12px;
    font-weight:700;
    margin-top:4px;
}

.timeline{
    margin-top:25px;
}

.timeline-title{
    font-size:13px;
    font-weight:700;
    margin-bottom:14px;
}

.timeline-item{
    display:flex;
    gap:12px;
    position:relative;
    padding-bottom:16px;
}

.timeline-line{
    position:absolute;
    left:4px;
    top:9px;
    bottom:0;
    width:1px;
    background:#ddd;
}

.timeline-item:last-child .timeline-line{
    display:none;
}

.timeline-dot{
    width:9px;
    height:9px;
    background:var(--gold);
    border-radius:50%;
    margin-top:4px;
    z-index:2;
}

.timeline-content{
    font-size:11px;
}

.timeline-date{
    font-size:9px;
    color:var(--muted);
    margin-top:3px;
}

/* =========================
   TRANSFER FORM
========================= */

.form-grid{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:16px;
}

.form-group label{
    display:block;
    font-size:10px;
    font-weight:600;
    margin-bottom:6px;
}

.form-group input,
.form-group select{
    width:100%;
}

.transfer-summary{
    background:#fafaf8;
    border-radius:10px;
    padding:16px;
    margin-top:18px;
}

.transfer-total{
    display:flex;
    justify-content:space-between;
    padding:7px 0;
    font-size:11px;
}

.modal-footer{
    padding:16px 24px;
    border-top:1px solid var(--border);
    display:flex;
    justify-content:flex-end;
    gap:8px;
}

/* =========================
   RESPONSIVE
========================= */

@media(max-width:1100px){
    .kpis{
        grid-template-columns:repeat(2,1fr);
    }

    .grid-2{
        grid-template-columns:1fr;
    }
}

@media(max-width:800px){
    .sidebar{
        width:70px;
        padding:18px 8px;
    }

    .logo h2,
    .logo span,
    .nav-title,
    .nav-item span,
    .nav-arrow,
    .user-info{
        display:none;
    }

    .logo{
        justify-content:center;
        padding-left:0;
        padding-right:0;
    }

    .nav-item{
        justify-content:center;
    }

    .sidebar-bottom{
        left:8px;
        right:8px;
    }

    .user{
        justify-content:center;
    }

    .main{
        margin-left:70px;
        width:calc(100% - 70px);
    }

    .content{
        padding:22px 18px;
    }

    .topbar{
        padding:0 18px;
    }

    .page-header{
        flex-direction:column;
        gap:15px;
    }

    .table-toolbar{
        flex-direction:column;
        align-items:stretch;
    }

    .search{
        width:100%;
    }

    .filters{
        overflow-x:auto;
    }

    .item-detail-grid{
        grid-template-columns:1fr;
    }
}

@media(max-width:550px){
    .kpis{
        grid-template-columns:1fr;
    }

    .spec-grid{
        grid-template-columns:repeat(2,1fr);
    }

    .form-grid{
        grid-template-columns:1fr;
    }

    .page-title{
        font-size:23px;
    }
}
</style>
</head>

<body>

<div class="app">

<!-- =========================
     SIDEBAR
========================= -->

<aside class="sidebar">

    <div class="logo">
        <div class="logo-mark">✦</div>
        <div>
            <h2>AURELIA ERP</h2>
            <span>JEWELLERY RETAIL SYSTEM</span>
        </div>
    </div>

    <nav class="nav">

        <div class="nav-title">Main</div>

        <div class="nav-item active" onclick="showSection('dashboard', this)">
            <div class="nav-icon">⌂</div>
            <span>Dashboard</span>
        </div>

        <div class="nav-item" onclick="showSection('inventory', this)">
            <div class="nav-icon">◈</div>
            <span>Inventory</span>
            <div class="nav-arrow">›</div>
        </div>

        <div class="nav-item" onclick="showSection('products', this)">
            <div class="nav-icon">◇</div>
            <span>Products & Designs</span>
        </div>

        <div class="nav-item" onclick="showTransfer()">
            <div class="nav-icon">⇄</div>
            <span>Stock Transfers</span>
        </div>

        <div class="nav-item" onclick="showVerification()">
            <div class="nav-icon">⌕</div>
            <span>Stock Verification</span>
        </div>

        <div class="nav-title" style="margin-top:22px;">Control</div>

        <div class="nav-item">
            <div class="nav-icon">▣</div>
            <span>Stock Adjustments</span>
        </div>

        <div class="nav-item">
            <div class="nav-icon">₹</div>
            <span>Stock Valuation</span>
        </div>

        <div class="nav-item">
            <div class="nav-icon">▤</div>
            <span>Reports</span>
        </div>

    </nav>

    <div class="sidebar-bottom">

        <div class="user">

            <div class="avatar">NP</div>

            <div class="user-info">
                <div class="user-name">Nishanth Prabhu</div>
                <div class="user-role">Administrator</div>
            </div>

        </div>

    </div>

</aside>


<!-- =========================
     MAIN
========================= -->

<main class="main">

<header class="topbar">

    <div class="branch">
        <span class="branch-label">Location</span>
        <strong>Main Showroom</strong>
        <span>⌄</span>
    </div>

    <div class="top-actions">

        <button class="icon-btn">
            ⌕
        </button>

        <button class="icon-btn">
            ♢
            <span class="notification-dot"></span>
        </button>

        <span style="font-size:11px;color:#777;">
            29 Aug 2026
        </span>

    </div>

</header>


<div class="content">

<!-- =========================
     DASHBOARD
========================= -->

<section id="dashboard">

    <div class="page-header">

        <div>
            <div class="eyebrow">Inventory Control</div>
            <h1 class="page-title">Jewellery Inventory</h1>
            <div class="page-description">
                Real-time visibility of every jewellery item across your business.
            </div>
        </div>

        <div>
            <button class="btn btn-primary" onclick="showTransfer()">
                + Stock Transfer
            </button>
        </div>

    </div>


    <!-- KPI -->

    <div class="kpis">

        <div class="kpi">

            <div class="kpi-top">
                <div class="kpi-label">Total Jewellery</div>
                <div class="kpi-icon">◈</div>
            </div>

            <div class="kpi-value">12,842</div>

            <div class="kpi-meta">
                <span class="up">↑ 4.8%</span> from last month
            </div>

        </div>


        <div class="kpi">

            <div class="kpi-top">
